# Copy this file to .env and fill in your local database credentials.
# The Prisma schema currently requires PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/canvasfolio?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/canvasfolio?schema=public"

# Generate a unique secret for your deployment (for example: openssl rand -hex 32).
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Supabase Storage settings. Leave blank to save uploads locally.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="uploads"

# Optional SMTP settings for contact-form email notifications.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_TO=""
